# Essential project files
include README.md
include requirements.txt

# Configuration files
recursive-include src/laueanalysis/config *.yml *.yaml *.json *.xml *.npy

# Native sources and compiled binaries
recursive-include src/laueanalysis/indexing/bin *
recursive-include src/laueanalysis/indexing/src *.c *.h makefile
recursive-include src/laueanalysis/reconstruct/bin *
recursive-include src/laueanalysis/reconstruct/source *.c *.cu *.h Makefile

# Exclude build artifacts and cache
global-exclude *.pyc *.pyo *.pyd __pycache__ .DS_Store *.o *.a
